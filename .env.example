# Postgres connection string. REQUIRED on Vercel/serverless (without it the site runs in demo mode
# with payments off). Supabase: Connect → "Transaction pooler" URI (port 6543). POSTGRES_URL also works.
# Leave empty locally to use a JSON file in .data/.
DATABASE_URL=

# Paystack secret key (Dashboard → Settings → API Keys & Webhooks).
# Use sk_test_... for testing and sk_live_... in production. Never expose it to the browser.
PAYSTACK_SECRET_KEY=

# Public URL of this app, used for the Paystack callback URL.
# Optional locally (derived from the request), recommended in production.
APP_URL=http://localhost:3000

# Optional: where the file-backed data store lives (defaults to ./.data).
# VILLAGE_DATA_DIR=

# Comma-separated emails that get the admin console (/admin) for verifying bills and recording payouts.
# Admins sign up normally; this only grants extra access. Leave empty to have no admins.
VILLAGE_ADMIN_EMAILS=

# VILLAGE Plus: create a Plan in the Paystack dashboard (Products → Plans) and paste its code.
# Price and billing interval are read from Paystack. Leave empty to hide subscriptions ("coming soon").
PAYSTACK_PLUS_PLAN_CODE=
